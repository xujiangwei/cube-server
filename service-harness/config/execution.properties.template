# Merge into private Harness config; explicitly upgrade the dedicated store to schema=4.
execution.enabled=false
execution.tenant=development
execution.subject=developer
execution.permissions=skill.list,skill.activate,resource.list,resource.read,resource.search
execution.max.active=128
execution.repository=C:/private/harness/resources
execution.repository.namespace=harness-resources
execution.repository.max.bytes=67108864
# Stable, unique JVM deployment identity; retain it across restarts for unknown reconciliation.
inference.node.id=harness-development-1

worker.baize-1.role=model
worker.baize-1.model=Baize
worker.baize-1.backend=baize-dedicated
worker.baize2-1.role=model
worker.baize2-1.model=Baize2
worker.baize2-1.backend=baize2-dedicated
worker.baize2-2.role=model
worker.baize2-2.model=Baize2
worker.baize2-2.backend=baize2-dedicated
# Default type=unit: Harness and AIGCService must share the same Kernel/JVM.
backend.baize-dedicated.type=unit
backend.baize-dedicated.capacity=1
backend.baize-dedicated.token=
backend.baize-dedicated.timeoutSeconds=180
backend.baize2-dedicated.type=unit
backend.baize2-dedicated.capacity=1
backend.baize2-dedicated.token=
backend.baize2-dedicated.timeoutSeconds=180
# If both logical models share one physical engine, use ONE backend id and limit for all workers.
# Tokens above are authorized Cube model tokens, distinct from worker and Harness API credentials.

# Explicit external option (assign the worker's backend to external-example to enable):

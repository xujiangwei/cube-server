# G0 only: private development configuration. Empty credentials refuse startup.
mode=development
http.host=127.0.0.1
http.port=7088
lease.millis=6000
worker.credential=
api.credential=
worker.model-1.role=model
worker.runner-1.role=runner
# Optional N03 ledger. See STORE.md. No automatic migration or run API enablement.
store.enabled=false
# Deploy with accepting=false; enable each new JVM explicitly after verification.
# Admin changes are node-local and reset to this startup value on restart.
execution.accepting=true
# Optional independent credential, >=24 characters; API/worker credentials are refused.
# admission.admin.credential=<private-independent-administrator-credential>

# Optional N11/N12. Requires execution.enabled and explicit current-schema migration.
# See CONTROL-FILES.md. Create an independent empty root before enabling files.
files.enabled=false
# files.root=C:/private/harness-files
# files.root.id=harness-files-1
# files.download.key=REPLACE_WITH_AT_LEAST_32_PRIVATE_CHARACTERS
# files.max.file.bytes=10485760
# files.max.bytes=1073741824
# control.approver.credential=REPLACE_WITH_DISTINCT_PRIVATE_CREDENTIAL
# control.approver.subject=independent-reviewer
# control.approval.tools=artifact.write_text
# control.wait.millis=300000
# control.cancel.grace.millis=10000
# Optional trusted SKILL query providers, installed separately from Harness.
# Provider-specific URLs, credentials and policy live in each private provider config.
# broker.providers=my-skill
# broker.provider.my-skill.class=your.skills.ReadOnlyProvider
# broker.provider.my-skill.config=C:/private/my-skill.properties
# TTL and cleanup defaults:
# Add to the SAME private file selected by -Dharness.config (harness.properties).
# cleanup.enabled controls physical deletion; logical expiry is always enforced by N12.
# cleanup.enabled=true
# cleanup.scan.interval.seconds=60
# cleanup.scan.batch.size=100
# cleanup.temp.grace.seconds=60
# cleanup.upload.ttl.seconds=86400
# retention.input.ttl.seconds=604800
# retention.artifact.ttl.seconds=2592000
# file.download.lease.seconds=300
# cleanup.claim.lease.seconds=120
# cleanup.retry.initial.seconds=30
# cleanup.retry.max.seconds=3600
# Restart required. TTL changes apply to NEW ready files, not existing expiresAt.

# N13 independent diagnostics; no external trace sink participates in recovery.
trace.enabled=false
trace.reader.credential=
trace.retention.seconds=604800
trace.export.max.bytes=262144
feedback.enabled=false
# N14/N15 external providers are NOT registered by default. See TRACE.md and
# workspace skill/harness-extensions/README.md; default Runner protocol is v4,
# opt-in runner JSON protocolVersion=5 supports reviewed generic IPC entrypoints.

# Optional certified Python sandbox Runner (Cell v6); no local controller/KVM paths in Java.
# worker.sandbox-a.role=runner
# worker.sandbox-a.capacity=1
# worker.sandbox-a.sandbox.profile.sha256=REPLACE_WITH_PROFILE_DIGEST
# worker.sandbox-a.sandbox.certificate.sha256=REPLACE_WITH_CERTIFICATE_SHA256

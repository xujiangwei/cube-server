# Add to the SAME private file selected by -Dharness.config (harness.properties).
# cleanup.enabled controls physical deletion; logical expiry is always enforced by N12.
# cleanup.enabled=true
# cleanup.scan.interval.seconds=60
# cleanup.scan.batch.size=100
# cleanup.temp.grace.seconds=60
# cleanup.upload.ttl.seconds=86400
# retention.input.ttl.seconds=604800
# retention.artifact.ttl.seconds=2592000
# file.download.lease.seconds=300
# cleanup.claim.lease.seconds=120
# cleanup.retry.initial.seconds=30
# cleanup.retry.max.seconds=3600
# Restart required. TTL changes apply to NEW ready files, not existing expiresAt.

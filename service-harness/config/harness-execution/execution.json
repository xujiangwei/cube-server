{
  "contextPolicy": {
    "budgetVersion": "transport-bytes-v1",
    "compaction": "extractive-v1",
    "maxInputBytes": 48000,
    "maxSourceChars": 4096,
    "outputReserve": 2048,
    "version": "context-v1",
    "taskState": true,
    "historyWindow": 3,
    "skillWindow": 6,
    "finalWireGuard": true
  },
  "executionLimits": {
    "maxLifetimeMillis": 300000,
    "maxRepairs": 2,
    "maxRounds": 8,
    "maxTools": 32,
    "maxRepeatedCalls": 3
  },
  "id": "server-default",
  "kind": "execution",
  "model": {
    "id": "Baize",
    "version": "1"
  },
  "requiredCapabilities": [
    "resources",
    "resource_decisions"
  ],
  "runtime": {
    "id": "resources",
    "version": "1"
  },
  "schemaVersion": 1,
  "version": "2"
}

<?xml version="1.0" encoding="UTF-8"?>
<project name="cube-service-harness" default="build" basedir=".">
  <property name="trace.test.config" value=""/>
  <property name="trace.test.output" value=""/>
  <property name="tools.test.config" value=""/>
  <property name="control.test.config" value=""/>
  <property name="build.dir" location="build"/>
  <property name="lib.dir" location="../deploy/libs"/>
  <property name="cell.jar" location="../deploy/bin/cell.jar"/>
  <property name="common.jar" location="../build/cube-common-3.0.jar"/>
  <property name="stage.dir" location="build/stage"/>
  <path id="cp"><pathelement location="${cell.jar}"/><pathelement location="${common.jar}"/><fileset dir="${lib.dir}" includes="*.jar"/><pathelement location="${build.dir}/classes"/></path>
  <target name="check">
    <fail message="Harness requires an actual JDK 8 (java.version=1.8)"><condition><not><matches string="${java.version}" pattern="^1\.8\."/></not></condition></fail>
    <available file="${common.jar}" property="common.present"/><fail unless="common.present" message="Build common with JDK 8 first, or set -Dcommon.jar to a verified cube-common-3.0.jar"/>
  </target>
  <target name="compile" depends="check">
    <mkdir dir="${build.dir}/classes"/>
    <javac srcdir="src" destdir="${build.dir}/classes" source="1.8" target="1.8" encoding="UTF-8" includeantruntime="false"><classpath refid="cp"/></javac>
    <copy todir="${build.dir}/classes/contracts"><fileset dir="contracts"/></copy>
    <copy todir="${build.dir}/classes"><fileset dir="resources"/></copy>
  </target>
  <target name="test-store" depends="test">
    <java classname="cube.service.harness.test.RunStoreTest" fork="true" failonerror="true">
      <classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath>
      <sysproperty key="store.test.config" value="${store.test.config}"/>
      <sysproperty key="store.test.output" value="${store.test.output}"/>
    </java>
  </target>
  <target name="build" depends="compile"><jar destfile="${build.dir}/cube-service-harness-3.0.jar" basedir="${build.dir}/classes"/></target>
  <target name="test-runtime" depends="test">
    <java classname="cube.service.harness.test.RuntimeTest" fork="true" failonerror="true">
      <classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath>
      <sysproperty key="runtime.test.config" value="${runtime.test.config}"/>
      <sysproperty key="runtime.test.migrator" value="${runtime.test.migrator}"/>
      <sysproperty key="runtime.test.output" value="${runtime.test.output}"/>
      <sysproperty key="runtime.test.root" value="${runtime.test.root}"/>
    </java>
  </target>
  <target name="test-execution" depends="test">
    <java classname="cube.service.harness.test.ExecutionTest" fork="true" failonerror="true">
      <classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath>
    </java>
  </target>
  <target name="test-tools" depends="test">
    <java classname="cube.service.harness.test.ToolTest" fork="true" failonerror="true"><classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath><sysproperty key="tools.test.config" value="${tools.test.config}"/></java>
    <java classname="cube.service.harness.test.QueryProviderTest" fork="true" failonerror="true"><classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath></java>
  </target>
  <target name="test-inference" depends="test">
    <java classname="cube.service.harness.test.InferenceTest" fork="true" failonerror="true"><classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath></java>
  </target>
  <target name="test-control-files" depends="test">
    <java classname="cube.service.harness.test.ControlFileTest" fork="true" failonerror="true"><classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath><sysproperty key="control.test.config" value="${control.test.config}"/></java>
  </target>
  <target name="test-trace" depends="test">
    <java classname="cube.service.harness.test.TraceTest" fork="true" failonerror="true"><classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath><sysproperty key="trace.test.output" value="${trace.test.output}"/><sysproperty key="trace.test.config" value="${trace.test.config}"/></java>
  </target>
  <target name="test-resilience" depends="test">
    <fail unless="resilience.test.output" message="Set -Dresilience.test.output to a new dedicated evidence directory"/>
    <java classname="cube.service.harness.test.ResilienceTest" fork="true" failonerror="true"><classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath><sysproperty key="resilience.test.output" value="${resilience.test.output}"/></java>
  </target>
  <target name="build-debug" depends="build"><copy file="${build.dir}/cube-service-harness-3.0.jar" todir="../build"/></target>
  <target name="build-release" depends="build-debug"/>
  <target name="test" depends="build">
    <mkdir dir="${build.dir}/test-classes"/>
    <javac srcdir="test" destdir="${build.dir}/test-classes" source="1.8" target="1.8" encoding="UTF-8" includeantruntime="false"><classpath refid="cp"/></javac>
    <java classname="cube.service.harness.test.ContractTest" fork="true" failonerror="true"><classpath><path refid="cp"/><pathelement location="${build.dir}/test-classes"/></classpath></java>
  </target>
  <target name="test-transport" depends="test">
    <available file="../build/cube-dispatcher-3.0.jar" property="dispatcher.present"/>
    <fail unless="dispatcher.present" message="Build dispatcher with JDK 8 before test-transport"/>
    <mkdir dir="${build.dir}/transport-test-classes"/>
    <path id="transport.cp"><pathelement location="../build/cube-dispatcher-3.0.jar"/><path refid="cp"/><pathelement location="${build.dir}/transport-test-classes"/></path>
    <javac srcdir="transport-test" destdir="${build.dir}/transport-test-classes" source="1.8" target="1.8" encoding="UTF-8" includeantruntime="false"><classpath refid="transport.cp"/></javac>
    <java classname="cube.dispatcher.harness.HarnessGatewayTest" fork="true" failonerror="true"><classpath refid="transport.cp"/></java>
    <java classname="cube.service.harness.test.HarnessCelletTest" fork="true" failonerror="true"><classpath refid="transport.cp"/></java>
  </target>
  <target name="stage" depends="build">
    <mkdir dir="${stage.dir}/cellets"/>
    <copy file="${build.dir}/cube-service-harness-3.0.jar" todir="${stage.dir}/cellets"/>
    <copy todir="${stage.dir}/config">
      <fileset dir="config" includes="harness.properties.template,execution.properties.template,standalone.xml,cohost-cellet.xml"/>
    </copy>
    <copy file="config/standalone.xml" tofile="${stage.dir}/cell.xml"/>
    <copy todir="${stage.dir}/scripts">
      <fileset dir="scripts" includes="run.sh,run.ps1,init_dev.py,evaluate_traces.py,replay_trace.py"/>
    </copy>
  </target>
  <target name="clean"><delete dir="${build.dir}"/></target>
</project>

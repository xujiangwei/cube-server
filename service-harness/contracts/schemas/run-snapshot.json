{
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_input",
        "waiting_approval",
        "cancelling",
        "reconciling",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "executionSettlement": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "unknown"
      ]
    },
    "taskProfileVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  },
  "required": [
    "runId",
    "version",
    "eventSeq",
    "state",
    "executionSettlement",
    "taskProfileVersion"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "maxItems": 64
          },
          "toolSetVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,

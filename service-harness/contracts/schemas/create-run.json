{
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "attachmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "maxItems": 16
        }
      },
      "required": [
        "instruction",
        "attachmentIds"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 257,
      "pattern": "^[A-Za-z0-9_.:-]+(@[A-Za-z0-9_.:-]+)?$"
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 257,
      "pattern": "^[A-Za-z0-9_.:-]+(@[A-Za-z0-9_.:-]+)?$"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_.-]*/[a-z][a-z0-9_.-]*$"
      },
      "maxItems": 64
    }
  },
  "required": [
    "input"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

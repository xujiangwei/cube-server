{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "error",
        "unknown"
      ]
    },
    "dataJson": {
      "type": "string",
      "maxLength": 65536
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 64
    },
    "errorCode": {
      "type": "string",
      "maxLength": 128
    }
  },
  "required": [
    "status",
    "artifacts"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

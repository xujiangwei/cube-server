{
  "type": "object",
  "properties": {
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "errorCode",
    "requestId",
    "retryable"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

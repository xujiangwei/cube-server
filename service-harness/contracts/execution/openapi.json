{
  "openapi": "3.0.3",
  "info": {
    "title": "Cube Harness task execution",
    "version": "2"
  },
  "paths": {
    "/harness/v1/runs": {
      "post": {
        "summary": "Create after durable commit; bounded admission",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/create-run.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durable success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/run-snapshot.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid schema/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "401": {
            "description": "Independent Harness credential required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "404": {
            "description": "No authorized resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict or EVENT_GAP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "429": {
            "description": "Bounded admission or SSE slots full",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "503": {
            "description": "Disabled/not ready/store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          }
        },
        "security": [
          {
            "HarnessBearer": []
          }
        ]
      }
    },
    "/harness/v1/runs/{runId}": {
      "get": {
        "summary": "Read snapshot, immutable final and separate actual usage",
        "responses": {
          "200": {
            "description": "Durable success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas/run-read.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid schema/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "401": {
            "description": "Independent Harness credential required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "404": {
            "description": "No authorized resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict or EVENT_GAP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "429": {
            "description": "Bounded admission or SSE slots full",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "503": {
            "description": "Disabled/not ready/store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          }
        },
        "security": [
          {
            "HarnessBearer": []
          }
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          }
        ]
      }
    },
    "/harness/v1/runs/{runId}/events": {
      "get": {
        "summary": "Finite ordered page; SSE reconnect with Last-Event-ID; 2 second deadline",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,15}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Durable success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas/events-page.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid schema/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "401": {
            "description": "Independent Harness credential required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "404": {
            "description": "No authorized resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict or EVENT_GAP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "429": {
            "description": "Bounded admission or SSE slots full",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "503": {
            "description": "Disabled/not ready/store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          }
        },
        "security": [
          {
            "HarnessBearer": []
          }
        ]
      }
    },
    "/harness/v1/capabilities": {
      "get": {
        "summary": "Protocol 2, model units, health and physical/effective capacity",
        "responses": {
          "200": {
            "description": "Enabled execution diagnostics"
          },
          "400": {
            "description": "Invalid schema/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "401": {
            "description": "Independent Harness credential required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "404": {
            "description": "No authorized resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict or EVENT_GAP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "429": {
            "description": "Bounded admission or SSE slots full",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          },
          "503": {
            "description": "Disabled/not ready/store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/error.json"
                }
              }
            }
          }
        },
        "security": [
          {
            "HarnessBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HarnessBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}

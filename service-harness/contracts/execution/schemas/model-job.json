{
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "roundId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "originFence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    },
    "intentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestJson": {
      "type": "string",
      "maxLength": 65536
    },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "model": {
      "type": "string",
      "enum": [
        "Baize",
        "Baize2",
        "scripted"
      ]
    }
  },
  "required": [
    "jobId",
    "runId",
    "roundId",
    "attempt",
    "originFence",
    "intentHash",
    "requestHash",
    "requestJson",
    "workerId",
    "instanceId",
    "sessionId",
    "model"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

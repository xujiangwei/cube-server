{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "unknown"
      ]
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "final"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tool_calls"
              ]
            },
            "calls": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "proposalId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "argumentsJson": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  }
                },
                "required": [
                  "proposalId",
                  "tool",
                  "argumentsJson"
                ],
                "additionalProperties": false
              },
              "maxItems": 16,
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "calls"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "need_input"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "question"
          ],
          "additionalProperties": false
        }
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "usage": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "responseHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "finishReason": {
            "type": "string",
            "maxLength": 64
          },
          "errorCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "usage": {
            "type": "object",
            "properties": {
              "input": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "output": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              }
            },
            "required": [
              "input",
              "output"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "attempt",
          "requestHash"
        ],
        "additionalProperties": false
      },
      "maxItems": 2
    },
    "cancellationObserved": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "audit",
    "cancellationObserved"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

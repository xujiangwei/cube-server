{
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "actualFinished": {
      "type": "boolean"
    },
    "outcomeJson": {
      "type": "string",
      "maxLength": 65536
    }
  },
  "required": [
    "jobId",
    "requestHash",
    "instanceId",
    "actualFinished",
    "outcomeJson"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

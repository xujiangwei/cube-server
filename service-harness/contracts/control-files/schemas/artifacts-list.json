{
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "uploading",
              "ready",
              "expired",
              "delete_pending",
              "deleted"
            ]
          },
          "downloadable": {
            "type": "boolean"
          }
        },
        "required": [
          "artifactId",
          "runId",
          "fileName",
          "mediaType",
          "size",
          "sha256",
          "expiresAt",
          "createdAt",
          "state",
          "downloadable"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "maxItems": 256
    }
  },
  "required": [
    "artifacts"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

{
  "type": "object",
  "properties": {
    "snapshot": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting_input",
            "waiting_approval",
            "cancelling",
            "reconciling",
            "succeeded",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "executionSettlement": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "unknown"
          ]
        },
        "executionProfileVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "selection": {
          "type": "object",
          "properties": {
            "model": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            "runtime": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[a-z][a-z0-9_.-]*/[a-z][a-z0-9_.-]*$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "name",
                  "version",
                  "digest"
                ],
                "additionalProperties": false
              },
              "maxItems": 64
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "maxItems": 4096
            }
          },
          "required": [
            "model",
            "runtime",
            "skills",
            "tools"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "runId",
        "version",
        "eventSeq",
        "state",
        "executionSettlement",
        "executionProfileVersion"
      ],
      "additionalProperties": false
    },
    "usageSettlement": {
      "type": "string",
      "enum": [
        "settled",
        "provisional"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "estimatedInput": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "estimatedOutput": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "actualInput": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "actualOutput": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "pending": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "estimatedInput",
        "estimatedOutput",
        "actualInput",
        "actualOutput",
        "pending"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "succeeded",
                "failed",
                "cancelled",
                "timed_out"
              ]
            },
            "executionSettlement": {
              "type": "string",
              "enum": [
                "confirmed",
                "unknown"
              ]
            },
            "result": {
              "type": "object"
            },
            "usage": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "maxItems": 64
            }
          },
          "required": [
            "state",
            "executionSettlement",
            "result",
            "usage"
          ],
          "additionalProperties": false
        }
      ]
    },
    "interaction": {
      "type": "object",
      "properties": {
        "waitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "input",
            "approval"
          ]
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "argumentsHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "waitId",
        "kind",
        "expiresAt",
        "argumentsHash",
        "details"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "snapshot",
    "usageSettlement",
    "usage",
    "result"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

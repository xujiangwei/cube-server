{
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "uploading",
        "ready",
        "expired",
        "delete_pending",
        "deleted"
      ]
    },
    "downloadable": {
      "type": "boolean"
    },
    "inputId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  },
  "required": [
    "fileName",
    "mediaType",
    "size",
    "sha256",
    "expiresAt",
    "createdAt",
    "state",
    "downloadable",
    "inputId"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

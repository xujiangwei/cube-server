{
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "jobHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "callId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "originFence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "intentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "release": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "tool": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "argumentsJson": {
      "type": "string",
      "maxLength": 16384
    },
    "argumentsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "bundleJson": {
      "type": "string",
      "maxLength": 180000
    },
    "workerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "instanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "runtimeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "maxLength": 128
    },
    "grant": {
      "type": "object",
      "properties": {
        "bodyJson": {
          "type": "string",
          "maxLength": 8192
        },
        "signature": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        }
      },
      "required": [
        "bodyJson",
        "signature"
      ],
      "additionalProperties": false
    },
    "timeoutMillis": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65536
    },
    "maxWorkspaceBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 10485760
    },
    "maxWorkspaceFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    }
  },
  "required": [
    "jobId",
    "jobHash",
    "runId",
    "callId",
    "attempt",
    "originFence",
    "intentHash",
    "tenantId",
    "subjectId",
    "release",
    "tool",
    "argumentsJson",
    "argumentsHash",
    "bundleJson",
    "workerId",
    "instanceId",
    "runtimeId",
    "grant",
    "timeoutMillis",
    "maxOutputBytes",
    "maxWorkspaceBytes",
    "maxWorkspaceFiles"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

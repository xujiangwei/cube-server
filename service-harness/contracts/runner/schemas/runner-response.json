            "instanceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
              "maxLength": 128
            },
            "runtimeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$",

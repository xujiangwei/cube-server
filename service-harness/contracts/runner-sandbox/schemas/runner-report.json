{
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "jobHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "actualFinished": {
      "type": "boolean"
    },
    "effectStatus": {
      "type": "string",
      "enum": [
        "none",
        "completed",
        "unknown"
      ]
    },
    "resultJson": {
      "type": "string",
      "maxLength": 65536
    }
  },
  "required": [
    "jobId",
    "jobHash",
    "actualFinished",
    "effectStatus",
    "resultJson"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

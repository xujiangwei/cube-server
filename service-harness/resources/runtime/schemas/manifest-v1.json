{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*/[a-z][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "skillFile": {
      "type": "string",
      "enum": [
        "SKILL.md"
      ]
    },
    "dependencyLock": {
      "type": "string",
      "enum": [
        "dependencies.lock.json"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 64
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "text/markdown",
              "text/plain",
              "application/json"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "skill",
              "resource",
              "schema",
              "lock",
              "entrypoint"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "size",
          "mediaType",
          "role"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "resource",
              "executable"
            ]
          },
          "inputSchema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "outputSchema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "permission": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "resourcePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "name",
          "kind",
          "inputSchema",
          "outputSchema",
          "permission"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "version",
    "runtime",
    "skillFile",
    "dependencyLock",
    "permissions",
    "files",
    "tools"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

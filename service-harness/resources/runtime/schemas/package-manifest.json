              "inputSchema",
              "outputSchema",
              "permission",
              "effect",
              "brokerOperation",
              "runnerType",
              "entrypoint"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "executable"
                ]
              },
              "inputSchema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "outputSchema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "permission": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,

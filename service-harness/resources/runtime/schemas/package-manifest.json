            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "text/markdown",
              "text/plain",
              "application/json"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "skill",
              "resource",
              "schema",
              "lock",
              "entrypoint"

              "inputSchema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "outputSchema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "permission": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "enum": [
                  "resource.read"

  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        6
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*/[a-z][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"

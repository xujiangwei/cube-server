{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "task"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "skillReleases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxItems": 64
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 64
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 64
    },
    "toolSetVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "contextPolicy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "budgetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "outputReserve": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maxSourceChars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "compaction": {
          "type": "string",
          "enum": [
            "extractive-v1"
          ]
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 2097152
        }
      },
      "required": [
        "version",
        "budgetVersion",
        "outputReserve",
        "maxSourceChars",
        "compaction",
        "maxInputBytes"
      ],
      "additionalProperties": false
    },
    "executionLimits": {
      "type": "object",
      "properties": {
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxTools": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "maxRepairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "maxLifetimeMillis": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000
        }
      },
      "required": [
        "maxRounds",
        "maxTools",
        "maxRepairs",
        "maxLifetimeMillis"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "model",
    "runtime",
    "skillReleases",
    "permissions",
    "requiredCapabilities",
    "toolSetVersion",
    "contextPolicy",
    "executionLimits"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

<?xml version="1.0" encoding="UTF-8"?>
<project name="cube-service-harness-skill" default="build" basedir=".">
  <property name="version.brand" value="3.0"/>
  <property name="version.tgt" value="1.8"/>
  <property name="version.src" value="1.8"/>
  <property name="build.dir" location="build"/>
  <property name="harness.module" location="../service-harness"/>
  <property name="python.exe" value="python"/>
  <path id="cp">
    <pathelement location="${harness.module}/build/cube-service-harness-3.0.jar"/>
    <pathelement location="../build/cube-common-3.0.jar"/>
    <pathelement location="../deploy/bin/cell.jar"/>
    <fileset dir="../deploy/libs" includes="*.jar"/>
    <pathelement location="${build.dir}/classes"/>
  </path>
  <target name="check">
    <!-- 全工程以 JDK 8 为构建基准：common 依赖 Nashorn（jdk.nashorn.api.scripting，JDK 15 起已移除），
         高版本 JDK 连 common 都编译不过；产物运行在 JDK 8 的 service 进程中，字节码必须是 1.8。
         这里约束构建 JVM，编译目标由 version.src / version.tgt 约束。 -->
    <fail message="Requires JDK 8, but Ant is running on java.version=${java.version} (java.home=${java.home}). Set JAVA_HOME to a JDK 8 and retry.">
      <condition><not><matches string="${java.version}" pattern="^1\.8\."/></not></condition>
    </fail>
    <available file="${harness.module}/build/cube-service-harness-3.0.jar" property="harness.present"/>
    <fail unless="harness.present" message="Build service-harness with JDK 8 first"/>
  </target>
  <target name="build" depends="check">
    <mkdir dir="${build.dir}/classes"/>
    <javac srcdir="src" destdir="${build.dir}/classes" target="${version.tgt}" source="${version.src}" encoding="UTF-8" includeantruntime="false"><classpath refid="cp"/></javac>
    <sync todir="${build.dir}/classes/cube/service/harness/skill/schemas"><fileset dir="harness-tools" includes="*/*.schema.json"/></sync>
    <jar destfile="${build.dir}/cube-service-harness-skill-${version.brand}.jar" basedir="${build.dir}/classes"/>
  </target>
  <target name="build-debug" depends="build"><copy file="${build.dir}/cube-service-harness-skill-${version.brand}.jar" todir="../build"/></target>
  <target name="build-release" depends="build-debug"/>
  <target name="packages">
    <exec executable="${python.exe}" failonerror="true"><arg value="-B"/><arg value="scripts/build_packages.py"/><arg value="--output"/><arg path="${build.dir}/packages"/></exec>
  </target>
  <target name="compile-tests" depends="build,packages">
    <ant dir="${harness.module}" target="test" inheritall="false"/>
    <mkdir dir="${build.dir}/test-classes"/>
    <javac srcdir="test" destdir="${build.dir}/test-classes" target="${version.tgt}" source="${version.src}" encoding="UTF-8" includeantruntime="false"><classpath><path refid="cp"/><pathelement location="${harness.module}/build/test-classes"/></classpath></javac>
  </target>
  <path id="test.cp"><path refid="cp"/><pathelement location="${harness.module}/build/test-classes"/><pathelement location="${build.dir}/test-classes"/></path>
  <target name="test" depends="compile-tests,test-media">
    <exec executable="${python.exe}" failonerror="true"><arg value="-B"/><arg value="scripts/test_smoke.py"/></exec>
    <java classname="cube.service.harness.skill.ProviderTest" fork="true" failonerror="true"><classpath refid="test.cp"/><arg path="${build.dir}/packages"/></java>
    <java classname="cube.service.harness.test.CommonToolsTest" fork="true" failonerror="true"><classpath refid="test.cp"/><arg path="${build.dir}/packages"/></java>
  </target>
  <target name="test-media" depends="compile-tests">
    <exec executable="${python.exe}" failonerror="true"><arg value="-B"/><arg path="../../forest/scripts/build_package.py"/><arg value="--tool-packages"/><arg path="${build.dir}/packages"/></exec>
    <java classname="cube.service.harness.test.MediaToolsTest" fork="true" failonerror="true"><classpath refid="test.cp"/><arg path="${build.dir}/packages"/><arg path="../../forest"/></java>
  </target>
  <target name="stage" depends="build,packages">
    <fail unless="stage.dir" message="Set -Dstage.dir to the intended Harness stage; this target does not activate providers"/>
    <mkdir dir="${stage.dir}/libs"/>
    <copy file="${build.dir}/cube-service-harness-skill-${version.brand}.jar" todir="${stage.dir}/libs"/>
    <copy todir="${stage.dir}/harness-skill/config"><fileset dir="config"/></copy>
    <copy todir="${stage.dir}/harness-skill/packages"><fileset dir="${build.dir}/packages" includes="*.zip"/></copy>
    <copy file="README.md" todir="${stage.dir}/harness-skill"/>
    <copy file="VERIFICATION.md" todir="${stage.dir}/harness-skill"/>
  </target>
  <target name="clean"><delete dir="${build.dir}/classes"/><delete dir="${build.dir}/test-classes"/><delete dir="${build.dir}/packages"/><delete file="${build.dir}/cube-service-harness-skill-${version.brand}.jar"/></target>
</project>

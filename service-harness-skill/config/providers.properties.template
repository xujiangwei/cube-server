# Install the JAR first. Register only the required providers.
broker.providers=search,web,knowledge,attachment,time,calculator
broker.provider.search.class=cube.service.harness.skill.SearchProvider
broker.provider.search.config=C:/private/harness/search.properties
broker.provider.web.class=cube.service.harness.skill.WebPageProvider
broker.provider.web.config=C:/private/harness/web.properties
broker.provider.knowledge.class=cube.service.harness.skill.KnowledgeProvider
broker.provider.knowledge.config=C:/private/harness/knowledge.properties
broker.provider.attachment.class=cube.service.harness.skill.TextAttachmentProvider
broker.provider.attachment.config=C:/private/harness/attachment.properties
broker.provider.time.class=cube.service.harness.skill.TimeProvider
broker.provider.time.config=C:/private/harness/time.properties
broker.provider.calculator.class=cube.service.harness.skill.CalculatorProvider
broker.provider.calculator.config=C:/private/harness/calculator.properties
# Optional data/media providers; follow service-harness/BUSINESS-DEPLOYMENT.md.
# Append data,capability to broker.providers after installing their private configuration.
# broker.provider.data.class=cube.service.harness.skill.DataQueryProvider
# broker.provider.data.config=C:/private/harness/data.properties
# broker.provider.capability.class=cube.service.harness.skill.CapabilityInvokeProvider
# broker.provider.capability.config=C:/private/harness/capability.properties
# Optional read-only profile discovery: append capabilities; grant capability.read.
# Reuse the invocation provider's capability.allowed.units private allowlist.
# broker.provider.capabilities.class=cube.service.harness.skill.CapabilityInspectProvider
# broker.provider.capabilities.config=C:/private/harness/capability.properties
# Optional processing provider; append processing to broker.providers and grant data.process.
# broker.provider.processing.class=cube.service.harness.skill.DataProcessProvider
# broker.provider.processing.config=C:/private/harness/processing.properties
# Optional configurable business resource retrieval; append retrieval and grant resource.retrieve.
# broker.provider.retrieval.class=cube.service.harness.skill.RetrievalProvider
# broker.provider.retrieval.config=C:/private/harness/retrieval.properties
# Optional workflow/report guard: add after installing matching core/skill JARs.
# Optional Python PDF text watermark: append document; grant document.watermark.
# broker.provider.document.class=cube.service.harness.skill.DocumentProvider
# broker.provider.document.config=C:/private/harness/document.properties
# File tools: append the desired ids to broker.providers; configure the matching worker environments.
# broker.provider.pdf.class=cube.service.harness.skill.FileUtilityProvider
# broker.provider.pdf.config=C:/private/harness/pdf.properties
# broker.provider.image.class=cube.service.harness.skill.FileUtilityProvider
# broker.provider.image.config=C:/private/harness/image.properties
# broker.provider.table.class=cube.service.harness.skill.FileUtilityProvider
# broker.provider.table.config=C:/private/harness/table.properties
# broker.provider.report.class=cube.service.harness.skill.FileUtilityProvider
# broker.provider.report.config=C:/private/harness/report.properties
# Existing Unit tools: append ocr and/or transcription; enable the corresponding AIGC Unit.
# broker.provider.ocr.class=cube.service.harness.skill.RecognitionProvider
# broker.provider.ocr.config=C:/private/harness/ocr.properties
# broker.provider.transcription.class=cube.service.harness.skill.RecognitionProvider
# broker.provider.transcription.config=C:/private/harness/transcription.properties
# broker.completion.guard.class=cube.service.harness.skill.WorkflowGuard
# broker.completion.guard.config=C:/private/harness/workflow.properties

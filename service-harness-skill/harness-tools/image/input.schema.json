{
  "type": "object",
  "properties": {
    "inputId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "format": {
      "type": "string",
      "maxLength": 32,
      "enum": [
        "jpg",
        "png"
      ]
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "maxWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "maxHeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 256,
      "maximum": 10485760
    },
    "quality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 95
    },
    "crop": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16000000
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16000000
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000000
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "inputId",
    "format"
  ],
  "additionalProperties": false
}

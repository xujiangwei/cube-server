{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "process",
        "read"
      ],
      "maxLength": 32
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*/[a-z][a-z0-9_.-]*$"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pageRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 64
    },
    "argumentsJson": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096
    },
    "datasetRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "view": {
      "type": "string",
      "enum": [
        "records",
        "groups"
      ],
      "maxLength": 32
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    }
  },
  "required": [
    "action",
    "skill",
    "profileId"
  ],
  "additionalProperties": false,
  "description": "加工当前任务已确认的完整 pageRefs，按固定 profile 去重、过滤和分组。action=process 需 pageRefs；action=read 需 datasetRef，不能混用。返回覆盖、统计和分页视图；不得手工合计或伪造 datasetRef。"
}

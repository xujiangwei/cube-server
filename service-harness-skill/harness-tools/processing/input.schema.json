{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "process",
        "read"
      ],
      "maxLength": 32
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*/[a-z][a-z0-9_.-]*$"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pageRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 64
    },
    "argumentsJson": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096
    },
    "datasetRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "view": {
      "type": "string",
      "enum": [
        "records",
        "groups"
      ],
      "maxLength": 32
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    }
  },
  "required": [
    "action",
    "skill",
    "profileId"
  ],
  "additionalProperties": false
}

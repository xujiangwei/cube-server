{
  "schemaVersion": 6,
  "name": "common/processing",
  "version": "1",
  "runtime": {
    "id": "trusted-cpu",
    "version": "1"
  },
  "skillFile": "SKILL.md",
  "dependencyLock": "dependencies.lock.json",
  "permissions": [
    "skill.list",
    "skill.activate",
    "resource.list",
    "resource.read",
    "resource.search",
    "data.process"
  ],
  "tools": [
    {
      "name": "common.processing.process",
      "kind": "executable",
      "entrypoint": "main.py",
      "inputSchema": "input.schema.json",
      "outputSchema": "output.schema.json",
      "permission": "data.process",
      "effect": "read-only",
      "brokerOperation": "common.processing.process.v1",
      "runnerType": "tool"
    }
  ],
  "resources": [
    {
      "path": "SKILL.md",
      "role": "skill",
      "mediaType": "text/markdown"
    },
    {
      "path": "dependencies.lock.json",
      "role": "lock",
      "mediaType": "application/json"
    },
    {
      "path": "main.py",
      "role": "entrypoint",
      "mediaType": "text/plain"
    },
    {
      "path": "input.schema.json",
      "role": "schema",
      "mediaType": "application/json"
    },
    {
      "path": "output.schema.json",
      "role": "schema",
      "mediaType": "application/json"
    }
  ]
}

{
  "type": "object",
  "properties": {
    "artifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "maxLength": 128
        },
        "runId": {
          "type": "string",
          "maxLength": 128
        },
        "fileName": {
          "type": "string",
          "maxLength": 256
        },
        "mediaType": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "application/pdf"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "sha256": {
          "type": "string",
          "maxLength": 64
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "artifactId",
        "runId",
        "fileName",
        "mediaType",
        "size",
        "sha256",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "maxLength": 64,
      "enum": [
        "pdf.watermark.v1"
      ]
    },
    "inputId": {
      "type": "string",
      "maxLength": 128
    }
  },
  "required": [
    "artifact",
    "operation",
    "inputId"
  ],
  "additionalProperties": false
}

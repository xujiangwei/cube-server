{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 16
          },
          "datasets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "datasetRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "recordIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1023
                      },
                      "profileId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "mediaRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "observation": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 4096
                      },
                      "assessment": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "not-assessed",
                              "review-required",
                              "normal",
                              "abnormal"
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048
                          },
                          "ruleIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "minItems": 0,
                            "maxItems": 8
                          }
                        },
                        "required": [
                          "status",
                          "reason",
                          "ruleIds"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "recordIndex",
                      "profileId",
                      "mediaRef",
                      "observation",
                      "assessment"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 1024
                }
              },
              "required": [
                "datasetRef",
                "findings"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 64
          }
        },
        "required": [
          "skill",
          "summary",
          "limitations",
          "datasets"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    }
  },
  "required": [
    "schemaVersion",
    "reports"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

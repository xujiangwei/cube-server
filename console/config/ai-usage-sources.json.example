[
  {
    "name": "aigc-main",
    "kind": "aigc",
    "type": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "database": "cube_aigc",
    "user": "cube_usage_reader",
    "passwordEnv": "CUBE_AI_USAGE_MYSQL_PASSWORD"
  },
  {
    "name": "harness-local",
    "kind": "harness",
    "type": "sqlite",
    "file": "C:/cube/service-harness/storage/harness.db"
  }
]
